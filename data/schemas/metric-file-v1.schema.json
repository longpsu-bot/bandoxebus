{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metric-file-v1.schema.json",
  "title": "Static Metric File V1",
  "type": "object",
  "required": ["schemaVersion", "metrics"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "value", "format"],
        "properties": {
          "label": { "type": "string" },
          "value": {},
          "format": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["integer", "decimal", "percentage", "distance", "currency", "text"] },
              "decimals": { "type": "integer", "minimum": 0, "maximum": 3 },
              "unit": { "type": "string" },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
            },
            "additionalProperties": false
          },
          "attribution": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
