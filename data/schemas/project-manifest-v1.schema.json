{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-manifest-v1.schema.json",
  "title": "Project Manifest V1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "locale",
    "stories",
    "map",
    "datasets",
    "assets",
    "focusTargets",
    "capabilities",
    "attribution"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "description": { "type": "string" },
    "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "organization": { "type": "string" },
    "author": { "type": "string" },
    "projectDate": { "type": "string", "format": "date" },
    "projectVersion": { "type": "string" },
    "stories": {
      "type": "object",
      "required": ["primary", "items"],
      "properties": {
        "primary": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "src"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "src": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "map": {
      "type": "object",
      "required": ["basemap", "initialView"],
      "properties": {
        "basemap": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "initialView": {
          "type": "object",
          "required": ["center", "zoom", "pitch", "bearing"],
          "properties": {
            "center": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "number", "minimum": -180, "maximum": 180 }
            },
            "zoom": { "type": "number", "minimum": 0, "maximum": 24 },
            "pitch": { "type": "number", "minimum": 0, "maximum": 72 },
            "bearing": { "type": "number", "minimum": -360, "maximum": 360 }
          },
          "additionalProperties": false
        },
        "minZoom": { "type": "number", "minimum": 0, "maximum": 24 },
        "maxZoom": { "type": "number", "minimum": 0, "maximum": 24 }
      },
      "additionalProperties": false
    },
    "datasets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "src", "label"],
        "properties": {
          "type": { "type": "string", "enum": ["geojson", "table-json"] },
          "geometry": { "type": "string", "enum": ["line", "point", "polygon", "mixed"] },
          "src": { "type": "string" },
          "role": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "label": { "type": "string" },
          "required": { "type": "boolean" },
          "attribution": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "render": {
            "type": "object",
            "required": ["type", "color"],
            "properties": {
              "type": { "type": "string", "enum": ["line", "point", "fill"] },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$" },
              "width": { "type": "number", "minimum": 0, "maximum": 64 },
              "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
              "lineStyle": { "type": "string", "enum": ["solid", "dashed"] },
              "radius": { "type": "number", "minimum": 0, "maximum": 64 },
              "strokeColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$" },
              "strokeWidth": { "type": "number", "minimum": 0, "maximum": 64 },
              "outlineColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$" },
              "outlineWidth": { "type": "number", "minimum": 0, "maximum": 64 },
              "label": {
                "type": "object",
                "required": ["field"],
                "properties": {
                  "field": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
                  "minZoom": { "type": "number", "minimum": 0, "maximum": 24 },
                  "placement": { "type": "string", "enum": ["auto", "point", "line", "centroid"] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "src", "mediaType"],
        "properties": {
          "type": { "type": "string", "const": "image" },
          "src": { "type": "string" },
          "mediaType": { "type": "string", "enum": ["image/avif", "image/gif", "image/jpeg", "image/png", "image/svg+xml", "image/webp"] },
          "required": { "type": "boolean" },
          "attribution": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          }
        },
        "additionalProperties": false
      }
    },
    "focusTargets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["datasets", "coordinate", "bounds"] },
          "datasets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "center": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "zoom": { "type": "number", "minimum": 0, "maximum": 24 },
          "bounds": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          },
          "camera": {
            "type": "object",
            "properties": {
              "maxZoom": { "type": "number", "minimum": 0, "maximum": 24 },
              "pitch": { "type": "number", "minimum": 0, "maximum": 72 },
              "bearing": { "type": "number", "minimum": -360, "maximum": 360 },
              "padding": { "type": "number", "minimum": 0, "maximum": 256 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "required": ["src"],
      "properties": {
        "src": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "settings": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "license": { "type": "string" },
          "updated": { "type": "string", "format": "date" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
