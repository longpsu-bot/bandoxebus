{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-1.2.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "states"],
  "properties": {
    "schemaVersion": { "const": "1.2" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "content", "map"],
        "properties": {
          "id": { "type": "string" },
          "content": {
            "type": "object",
            "required": ["layout", "blocks"],
            "properties": {
              "layout": { "const": "freeform-16x9" },
              "blocks": { "type": "array", "items": { "type": "object" } },
              "presenterNote": { "type": "string" }
            },
            "additionalProperties": false
          },
          "map": {
            "type": "object",
            "required": ["camera", "interaction", "transition", "layerVisibility", "enter", "exit"],
            "properties": {
              "camera": {
                "type": "object",
                "required": ["center", "zoom", "pitch", "bearing"],
                "properties": {
                  "center": { "type": "array", "items": { "type": "number" } },
                  "zoom": { "type": "number", "minimum": 0, "maximum": 24 },
                  "pitch": { "type": "number", "minimum": 0, "maximum": 72 },
                  "bearing": { "type": "number", "minimum": -360, "maximum": 360 }
                },
                "additionalProperties": false
              },
              "interaction": { "type": "string", "enum": ["locked", "zoom-only", "explore"] },
              "transition": {
                "type": "object",
                "required": ["type", "durationMs"],
                "properties": {
                  "type": { "type": "string", "enum": ["fly", "ease", "instant"] },
                  "durationMs": { "type": "integer", "minimum": 0, "maximum": 10000 }
                },
                "additionalProperties": false
              },
              "layerVisibility": { "type": "object", "additionalProperties": { "type": "boolean" } },
              "enter": { "type": "array", "items": { "type": "object" } },
              "exit": { "type": "array", "items": { "type": "object" } }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
